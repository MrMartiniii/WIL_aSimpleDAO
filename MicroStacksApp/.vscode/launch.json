{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Run Mocha Tests",
        "program": "${workspaceFolder}/node_modules/mocha/bin/mocha",
        "args": [
          "--loader",
          "ts-node/esm",
          "--timeout",
          "999999",
          "--colors",
          "${workspaceFolder}/tests/**/*.test.ts"
        ],
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      }
    ]
  }
  